# CampOS - Campus Operating System Environment Configuration

# Server Port
PORT=8000

# Database Configuration (SQLite local persistence by default; PostgreSQL / Supabase supported)
DB_PATH="campos.db"

# JWT Authentication
JWT_SECRET="campos_production_secure_secret_key_change_in_prod"

# Supabase Credentials (optional / fallback for cloud PostgreSQL)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-or-service-role-key"
